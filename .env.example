# Modelo do .env. Copie para `.env` na raiz e preencha só o que for usar:
#
#     cp .env.example .env
#
# Tudo aqui é opcional. Cada linha em branco cai no padrão de desenvolvimento embutido nos
# `application.yml`, e é por isso que o projeto sobe sem configurar nada. Copiar este arquivo
# inteiro é seguro: valor vazio é descartado no carregamento, não vira variável vazia.
#
# Quem lê este arquivo:
#   - `docker compose up -d`  → nativamente, para o Postgres e o MinIO
#   - `./gradlew bootRun`     → via `backend/build.gradle`, para a API e o Worker
#
# Quem NÃO lê: o app Flutter (usa `--dart-define`) e o `java -jar` de produção (usa as
# variáveis de ambiente do orquestrador). Ver `CREDENCIAIS.md` para onde obter cada valor.
#
# O `.env` está no `.gitignore`. Este exemplo não deve conter valor nenhum.


# --- Inteligência artificial (Worker) ------------------------------------------------
# Basta UMA das duas chaves. Vazias as duas, treino e dieta saem apenas do motor de regras,
# sem narrativa, e a análise de foto de refeição não funciona.
# Gemini: https://aistudio.google.com/apikey
MYOTRACK_GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
MYOTRACK_OPENAI_API_KEY=

# Vazio = autodetecção pela chave preenchida, com precedência do Gemini (mais barato por
# token). Preencha com "openai" ou "gemini" para forçar.
MYOTRACK_LLM_PROVIDER=
MYOTRACK_GEMINI_MODEL=
MYOTRACK_OPENAI_MODEL=
# Geração de imagem, cobrada por imagem. É a chamada mais cara do app por uma ordem de
# grandeza, e o renderizador local faz a mesma anotação de graça. Ver "Custo de IA" no README
# antes de ligar.
MYOTRACK_GEMINI_IMAGE_MODEL=

# Serviço de visão (repositório `MyoTrack`, pasta `vision/`). Sem ele, análise de vídeo falha.
MYOTRACK_VISION_BASE_URL=


# --- Segurança (API) -----------------------------------------------------------------
# O ÚNICO item urgente antes de qualquer publicação: o padrão é uma chave de desenvolvimento
# pública, e quem a conhece emite token de qualquer usuário. Gere com:
#     openssl rand -base64 48
MYOTRACK_JWT_SIGNING_KEY=


# --- Banco e armazenamento (API e Worker) ---------------------------------------------
# Vazios, apontam para o Postgres e o MinIO do docker-compose, com senha `dev-only-password`.
MYOTRACK_DB_URL=
MYOTRACK_DB_USER=
MYOTRACK_DB_PASSWORD=
MYOTRACK_STORAGE_ENDPOINT=
MYOTRACK_STORAGE_ACCESS_KEY=
MYOTRACK_STORAGE_SECRET_KEY=
MYOTRACK_STORAGE_BUCKET=
MYOTRACK_STORAGE_REGION=
# Endereço das URLs pré-assinadas de mídia. `localhost` não é alcançável pelo celular: no
# emulador Android, use http://10.0.2.2:9000 — sem isso a foto da refeição nunca carrega.
MYOTRACK_STORAGE_PUBLIC_ENDPOINT=

# Senhas dos containers do compose. Mudá-las aqui exige mudar as de cima junto — são o mesmo
# banco visto dos dois lados.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=


# --- Login social (API) ---------------------------------------------------------------
# Google Cloud Console > APIs e Serviços > Credenciais. Precisa de um client OAuth do tipo
# Web e um do tipo Android. Vazios, o botão "Continuar com Google" não aparece.
MYOTRACK_GOOGLE_CLIENT_ID=
MYOTRACK_GOOGLE_CLIENT_SECRET=
MYOTRACK_GOOGLE_ANDROID_CLIENT_IDS=
# Bundle id do app iOS. Vazio, o botão da Apple não aparece.
MYOTRACK_APPLE_AUDIENCES=
#
# ATENÇÃO: o app precisa do client id do tipo Web em MYOTRACK_GOOGLE_SERVER_CLIENT_ID, que
# NÃO se configura aqui — é build do Flutter:
#     flutter run --dart-define=MYOTRACK_GOOGLE_SERVER_CLIENT_ID=...
# É o erro de configuração mais comum do Google Sign-In.


# --- E-mail (API) ----------------------------------------------------------------------
# Sem user e password o envio fica desligado e a mensagem só vai para o log da API — o que
# quebra a redefinição de senha de ponta a ponta. No Gmail, exige senha de app.
MYOTRACK_EMAIL_USER=
MYOTRACK_EMAIL_PASSWORD=
MYOTRACK_EMAIL_FROM=
MYOTRACK_EMAIL_HOST=
MYOTRACK_EMAIL_PORT=


# --- Pagamentos (API) -------------------------------------------------------------------
# Vazios, os pagamentos ficam desabilitados e todo mundo usa o plano gratuito.
MYOTRACK_STRIPE_SECRET_KEY=
MYOTRACK_STRIPE_WEBHOOK_SECRET=
MYOTRACK_STRIPE_PRO_PRICE_ID=


# --- Push (Worker) ----------------------------------------------------------------------
MYOTRACK_FCM_PROJECT_ID=
# O CONTEÚDO do JSON da conta de serviço, não o caminho. Como é uma linha só com aspas e
# quebras escapadas, guardá-lo aqui é frágil: prefira exportar a variável no ambiente.
MYOTRACK_FCM_CREDENTIALS_JSON=


# --- Rede (API) -------------------------------------------------------------------------
MYOTRACK_API_PORT=
# Base dos links enviados por e-mail e do redirect do OAuth.
MYOTRACK_PUBLIC_BASE_URL=
MYOTRACK_CORS_ORIGINS=
